# ============================================================
# ستوديو القوالب — إعدادات Apache / cPanel
# يوضع في مجلد النشر (مثلاً public_html/themes/)
# ============================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# منع الوصول المباشر لمجلد server (الكود + قاعدة البيانات + البذور)
RewriteRule ^server/ - [F,L]

# توجيه كل طلبات api إلى المتحكم الأمامي
RewriteCond %{REQUEST_URI} !/api\.php$
RewriteRule ^api(/.*)?$ api.php [QSA,L]

# أي مسار غير موجود → الواجهة (توجيه SPA)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
</IfModule>

# أنواع MIME صحيحة
AddType text/javascript .js .mjs
AddType text/css .css
AddType application/json .json
AddType image/svg+xml .svg

# حماية إضافية لملفات القاعدة
<FilesMatch "\.(sqlite|sqlite-journal|sqlite-wal|sqlite-shm)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# ضغط المحتوى
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# تخزين مؤقت للأصول
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType text/javascript "access plus 7 days"
ExpiresByType image/svg+xml "access plus 7 days"
ExpiresByType image/png "access plus 7 days"
ExpiresByType font/woff2 "access plus 7 days"
</IfModule>
